{
  "name": "clash-market-telegram-bot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "test": "node --test",
    "check": "find src scripts test -name \"*.js\" -print0 | xargs -0 -n1 node --check"
  },
  "devDependencies": {
    "wrangler": "^4.45.0"
  },
  "engines": {
    "node": ">=20"
  }
}
